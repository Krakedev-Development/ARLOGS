{
  "name": "arlogs-app",
  "version": "1.0.0",
  "scripts": {
    "ng": "node ./node_modules/@angular/cli/bin/bootstrap.js",
    "start": "node ./node_modules/@angular/cli/bin/bootstrap.js serve",
    "build": "node ./node_modules/@angular/cli/bin/bootstrap.js build",
    "watch": "node ./node_modules/@angular/cli/bin/bootstrap.js build --watch --configuration development",
    "test": "node ./node_modules/@angular/cli/bin/bootstrap.js test",
    "test:ci": "node ./node_modules/@angular/cli/bin/bootstrap.js test --watch=false",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{ts,html,css}\"",
    "format:check": "prettier --check \"src/**/*.{ts,html,css}\"",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm run test:ci && npm run build"
  },
  "private": true,
  "packageManager": "npm@11.17.0",
  "dependencies": {
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "bootstrap": "^5.3.9",
    "bootstrap-icons": "^1.13.2",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@angular/build": "^22.2.6",
    "@angular/cli": "^22.2.6",
    "@angular/compiler-cli": "^22.2.0",
    "@eslint/js": "^10.0.1",
    "angular-eslint": "^22.8.0",
    "eslint": "^10.15.0",
    "jsdom": "^30.0.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.0.0"
  }
}
